ENV=development
DEBUG=true
APP_NAME=FeedWise API
API_V1_PREFIX=/api/v1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

AI_ENABLED=false
